<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ad_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gnt_bg_dark"
    android:elevation="100dp">

    <!-- NativeAdView hiển thị toàn màn hình -->
    <com.google.android.gms.ads.nativead.NativeAdView
        android:id="@+id/native_ad_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/gnt_bg_dark">

            <!-- 1. MediaView chiếm toàn bộ chiều cao còn lại phía trên đường phân cách -->
            <com.google.android.gms.ads.nativead.MediaView
                android:id="@+id/media_view"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toTopOf="@id/divider"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.0" />

            <!-- Đường phân cách giữa media_view và bottom_card (màu #505763) -->
            <View
                android:id="@+id/divider"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="#505763"
                app:layout_constraintBottom_toTopOf="@id/bottom_card"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- 2. Thẻ footer ở phía dưới cùng với chiều cao responsive -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/bottom_card"
                android:layout_width="0dp"
                android:layout_height="@dimen/gnt_fs_bottom_card_height"
                android:background="@color/gnt_bg_dark"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <!-- Icon responsive -->
                <ImageView
                    android:id="@+id/icon"
                    android:layout_width="@dimen/gnt_fs_icon_size"
                    android:layout_height="@dimen/gnt_fs_icon_size"
                    android:scaleType="fitCenter"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:src="@android:drawable/sym_def_app_icon" />

                <!-- Nút CTA bên phải responsive -->
                <android.widget.Button
                    android:id="@+id/cta"
                    android:layout_width="@dimen/gnt_fs_cta_width"
                    android:layout_height="@dimen/gnt_fs_cta_height"
                    android:background="@drawable/ad_cta_fullscreen_background"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="@color/gnt_white"
                    android:textSize="@dimen/gnt_fs_cta_text_size"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Open" />

                <!-- Container cho Title và Subtitle kéo dài giữa Icon và CTA -->
                <LinearLayout
                    android:id="@+id/content"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/cta"
                    app:layout_constraintStart_toEndOf="@id/icon"
                    app:layout_constraintTop_toTopOf="parent">

                    <!-- Dòng trên: Nhãn Ad + Title (primary) -->
                    <LinearLayout
                        android:id="@+id/headline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/ad_notification_view"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/ad_badge_yellow_background"
                            android:gravity="center"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:paddingTop="1dp"
                            android:paddingBottom="1dp"
                            android:text="Ad"
                            android:textColor="@color/gnt_ad_badge_text_brown"
                            android:textSize="@dimen/gnt_fs_ad_badge_size"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/primary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/gnt_white"
                            android:textSize="@dimen/gnt_fs_headline_size"
                            android:textStyle="bold"
                            tools:text="Title" />
                    </LinearLayout>

                    <!-- Dòng dưới: Secondary / Subtitle -->
                    <TextView
                        android:id="@+id/secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#B6BCC3"
                        android:textSize="@dimen/gnt_fs_secondary_size"
                        tools:text="Make your business more visible!" />

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 3. Nút đóng ở góc trên bên phải -->
            <ImageView
                android:id="@+id/ad_close_button"
                android:layout_width="@dimen/gnt_fs_close_btn_size"
                android:layout_height="@dimen/gnt_fs_close_btn_size"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="15dp"
                android:contentDescription="Close Ad"
                android:src="@drawable/ic_cancel"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible" />

            <!-- 4. Thanh progress đếm ngược màu vàng sát mép trên màn hình, kéo dài trọn chiều ngang -->
            <ProgressBar
                android:id="@+id/ad_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:tag="line_fill"
                android:indeterminate="false"
                android:progress="0"
                android:progressDrawable="@drawable/line_yellow_progress_bar"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.gms.ads.nativead.NativeAdView>
</FrameLayout>