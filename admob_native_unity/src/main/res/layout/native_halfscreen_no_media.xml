<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ad_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:elevation="50dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Guideline phân chia chiều cao màn hình dọc thành 50% -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_half"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.5" />

        <!-- NativeAdView chỉ chiếm nửa dưới màn hình (50% chiều cao) -->
        <com.google.android.gms.ads.nativead.NativeAdView
            android:id="@+id/native_ad_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/guideline_half">

            <!-- Khung card quảng cáo thực tế chiếm toàn bộ diện tích của NativeAdView -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/gnt_bg_native_solid">

                <!-- 1. Headline Vùng Click Phủ Tràn Mép Toàn Bộ Quảng Cáo:
                     Kéo căng 0dp x 0dp chạm 4 góc ngoài cùng của NativeAdView.
                     Padding được căn chỉnh để text hiển thị ngay cạnh nhãn Ad ở góc trên bên trái -->
                <TextView
                    android:id="@+id/headline"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:ellipsize="end"
                    android:gravity="top|start"
                    android:maxLines="1"
                    android:paddingTop="17dp"
                    android:paddingStart="86dp"
                    android:paddingEnd="60dp"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Quảng cáo thử nghiệm" />

                <!-- 2. Nhãn Ad màu vàng ở góc trên bên trái (sau đồng hồ đếm ngược) -->
                <TextView
                    android:id="@+id/ad_notification_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="55dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/ad_badge_yellow_background"
                    android:gravity="center"
                    android:paddingBottom="1dp"
                    android:paddingEnd="5dp"
                    android:paddingStart="5dp"
                    android:paddingTop="1dp"
                    android:text="Ad"
                    android:textColor="@color/gnt_ad_badge_text_brown"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- 3. Mô tả phụ (Advertiser) bên dưới nhãn Ad và Headline -->
                <TextView
                    android:id="@+id/advertiser"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="55dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="60dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#B0BEC5"
                    android:textSize="13sp"
                    app:layout_constraintEnd_toStartOf="@id/ad_close_button"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ad_notification_view"
                    tools:text="Install Flood-It App for free!" />

                <!-- 4. Icon quảng cáo căn giữa -->
                <ImageView
                    android:id="@+id/icon"
                    android:layout_width="@dimen/no_media_icon_size"
                    android:layout_height="@dimen/no_media_icon_size"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:scaleType="fitCenter"
                    android:background="@android:color/darker_gray"
                    app:layout_constraintBottom_toTopOf="@id/cta"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/advertiser"
                    tools:src="@android:drawable/sym_def_app_icon" />

                <!-- 5. Nút CTA kéo dài toàn bộ chiều rộng ở dưới cùng của thẻ -->
                <Button
                    android:id="@+id/cta"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginBottom="16dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/btn_cta_blue"
                    android:gravity="center"
                    android:textColor="@color/gnt_white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:text="INSTALL" />

                <!-- 4. Nút đóng đặt ở góc trên bên phải đè lên trên tiêu đề -->
                <ImageView
                    android:id="@+id/ad_close_button"
                    android:layout_width="@dimen/close_btn_size"
                    android:layout_height="@dimen/close_btn_size"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="20dp"
                    android:clickable="true"
                    android:contentDescription="Close Ad"
                    android:elevation="20dp"
                    android:focusable="true"
                    android:src="@drawable/ic_cancel"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- 5. Bộ đếm ngược đặt ở góc trên bên phải đè lên trên tiêu đề (cùng vị trí nút đóng) -->
                <ProgressBar
                    android:id="@+id/ad_progress_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="23dp"
                    android:layout_marginStart="23dp"
                    android:elevation="20dp"
                    android:indeterminate="false"
                    android:progress="100"
                    android:progressDrawable="@drawable/circular_progress_bar"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/ad_countdown_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:elevation="20dp"
                    android:gravity="center"
                    android:textColor="@color/icon_grey"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/ad_progress_bar"
                    app:layout_constraintEnd_toEndOf="@id/ad_progress_bar"
                    app:layout_constraintStart_toStartOf="@id/ad_progress_bar"
                    app:layout_constraintTop_toTopOf="@id/ad_progress_bar"
                    tools:text="5"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.gms.ads.nativead.NativeAdView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
