<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="300dp"
    android:layout_height="250dp"
    android:id="@+id/ad_content"
    android:elevation="10dp">

    <com.google.android.gms.ads.nativead.NativeAdView
        android:id="@+id/native_ad_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="start|center_vertical"
        android:background="@android:color/white"
        android:elevation="4dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/gnt_bg_native_solid">

            <!-- 1. Headline Vùng Click Phủ Tràn Mép Toàn Bộ Quảng Cáo:
                 Kéo căng 0dp x 0dp chạm 4 góc ngoài cùng của NativeAdView.
                 Padding được căn chỉnh để text hiển thị ngay cạnh nhãn Ad ở góc trên bên trái -->
            <TextView
                android:id="@+id/headline"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:ellipsize="end"
                android:gravity="top|start"
                android:maxLines="1"
                android:paddingTop="10dp"
                android:paddingStart="40dp"
                android:paddingEnd="16dp"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Headline" />

            <!-- 2. Nút CTA ở dưới cùng -->
            <Button
                android:id="@+id/cta"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/btn_cta_blue"
                android:gravity="center"
                android:lines="1"
                android:textColor="@color/gnt_white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                tools:text="CONTINUE" />

            <!-- 3. Layout chứa thông tin chữ ở trên cùng -->
            <LinearLayout
                android:id="@+id/info_bar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Nhãn Ad màu vàng -->
                <TextView
                    android:id="@+id/ad_notification_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ad_badge_yellow_background"
                    android:gravity="center"
                    android:paddingBottom="1dp"
                    android:paddingEnd="5dp"
                    android:paddingStart="5dp"
                    android:paddingTop="1dp"
                    android:text="Ad"
                    android:textColor="@color/gnt_ad_badge_text_brown"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <!-- Dòng dưới: Advertiser text (Mô tả quảng cáo) -->
                <TextView
                    android:id="@+id/advertiser"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="12sp"
                    tools:text="body/advertise" />

            </LinearLayout>

            <!-- 4. Icon quảng cáo co giãn tự động nằm ở không gian giữa -->
            <ImageView
                android:id="@+id/icon"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:scaleType="fitCenter"
                android:background="@android:color/transparent"
                app:layout_constraintWidth_max="110dp"
                app:layout_constraintHeight_max="110dp"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintBottom_toTopOf="@id/cta"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/info_bar"
                tools:src="@android:drawable/sym_def_app_icon" />

            <RatingBar
                android:id="@+id/rating_bar"
                style="?android:attr/ratingBarStyleSmall"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.gms.ads.nativead.NativeAdView>
</FrameLayout>
