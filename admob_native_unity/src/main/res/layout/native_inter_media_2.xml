<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ad_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gnt_white"
    android:elevation="100dp">

    <!-- NativeAdView hiển thị toàn màn hình Interstitial 2 (Portrait) -->
    <com.google.android.gms.ads.nativead.NativeAdView
        android:id="@+id/native_ad_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/gnt_white">

            <!-- 1. Phần bên dưới: Thẻ chứa thông tin và nút CTA (nền trắng) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/bottom_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@color/gnt_white"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <!-- Dòng 1: Nhãn Ad vàng -->
                <TextView
                    android:id="@+id/ad_notification_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/ad_badge_yellow_background"
                    android:gravity="center"
                    android:paddingBottom="1dp"
                    android:paddingEnd="6dp"
                    android:paddingStart="6dp"
                    android:paddingTop="1dp"
                    android:text="Ad"
                    android:textColor="@color/gnt_ad_badge_text_brown"
                    android:textSize="@dimen/gnt_land_inter_ad_badge_size"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Dòng 2: Advertiser (Mô tả phụ) -->
                <TextView
                    android:id="@+id/advertiser"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/gnt_gray"
                    android:textSize="@dimen/gnt_land_inter_secondary_size"
                    app:layout_constraintBottom_toTopOf="@id/cta"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ad_notification_view"
                    tools:text="body/advertise" />

                <!-- Dòng 3: Nút CTA màu xanh lá cây -->
                <android.widget.Button
                    android:id="@+id/cta"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/gnt_land_inter_btn_height"
                    android:layout_marginBottom="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/btn_cta_green"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="CTA"
                    android:textColor="@color/gnt_white"
                    android:textSize="@dimen/gnt_land_inter_btn_text_size"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/advertiser"
                    tools:text="CTA" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 2. Phần bên trên: Chiếm toàn bộ không gian còn lại phía trên bottom_card, nền D9D9D9, chứa MediaView -->
            <FrameLayout
                android:id="@+id/media_container"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@color/gnt_gray_d9"
                app:layout_constraintBottom_toTopOf="@id/bottom_card"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.gms.ads.nativead.MediaView
                    android:id="@+id/media_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <!-- 3. Headline Vùng Click Phủ Tràn Mép Toàn Màn Hình:
                 Kéo căng 100% chạm 4 góc ngoài cùng. Text hiển thị ngay cạnh nhãn Ad ở thẻ dưới -->
            <TextView
                android:id="@+id/headline"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:ellipsize="end"
                android:gravity="bottom|start"
                android:maxLines="1"
                android:paddingBottom="@dimen/gnt_inter_2_portrait_headline_padding_bottom"
                android:paddingEnd="20dp"
                android:paddingStart="@dimen/gnt_inter_2_portrait_headline_padding_start"
                android:textColor="@color/gnt_black"
                android:textSize="@dimen/gnt_land_inter_headline_size"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Headline" />

            <!-- 4. Vòng tròn đếm ngược đè ở góc trên bên phải màn hình -->
            <ProgressBar
                android:id="@+id/ad_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="@dimen/gnt_land_inter_progress_size"
                android:layout_height="@dimen/gnt_land_inter_progress_size"
                android:layout_marginEnd="15dp"
                android:layout_marginTop="15dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="100"
                android:progressDrawable="@drawable/circular_progress_bar"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible" />

            <!-- Text số giây đếm ngược bên trong vòng tròn -->
            <TextView
                android:id="@+id/ad_countdown_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/gnt_gray_7f"
                android:textSize="@dimen/gnt_land_inter_countdown_text_size"
                android:textStyle="bold"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/ad_progress_bar"
                app:layout_constraintEnd_toEndOf="@id/ad_progress_bar"
                app:layout_constraintStart_toStartOf="@id/ad_progress_bar"
                app:layout_constraintTop_toTopOf="@id/ad_progress_bar"
                tools:text="5"
                tools:visibility="visible" />

            <!-- 5. Nút Close ở góc trên bên phải (cùng vị trí với ad_progress_bar) -->
            <ImageView
                android:id="@+id/ad_close_button"
                android:layout_width="@dimen/close_btn_size"
                android:layout_height="@dimen/close_btn_size"
                android:layout_marginEnd="15dp"
                android:layout_marginTop="15dp"
                android:contentDescription="Close Ad"
                android:src="@drawable/ic_cancel"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.gms.ads.nativead.NativeAdView>
</FrameLayout>
