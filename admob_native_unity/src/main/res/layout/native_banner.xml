<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|center_horizontal"
    android:id="@+id/ad_content">

    <!-- NativeAdView được đặt ở dưới cùng và có chiều cao tự động -->
    <com.google.android.gms.ads.nativead.NativeAdView
        android:id="@+id/native_ad_view"
        android:layout_width="match_parent"
        android:layout_height="@dimen/banner_ad_height"
        android:layout_gravity="bottom|center_horizontal">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/background"
            android:layout_width="match_parent"
            android:layout_height="@dimen/banner_background_height"
            android:paddingHorizontal="8dp"
            android:layout_gravity="bottom|center_horizontal"
            android:background="@drawable/native_banner_background">

            <!-- Icon quảng cáo bên trái -->
            <ImageView
                android:id="@+id/icon"
                android:layout_width="@dimen/banner_icon_width"
                android:layout_height="@dimen/banner_icon_height"
                android:scaleType="fitCenter"
                android:layout_marginStart="@dimen/banner_icon_margin_start"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:src="@android:drawable/sym_def_app_icon" />

            <!-- Nút CTA bên phải -->
            <android.widget.Button
                android:id="@+id/cta"
                android:layout_width="@dimen/banner_cta_width"
                android:minWidth="@dimen/banner_cta_min_width"
                android:layout_height="@dimen/banner_cta_height"
                android:background="@drawable/ad_cta_button_banner_background"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="#0E2139"
                android:textStyle="bold"
                android:textSize="15sp"
                android:gravity="center"
                android:maxLines="1"
                android:layout_marginEnd="@dimen/banner_cta_margin_end"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Install" />

            <!-- Container cho khối text ở giữa -->
            <LinearLayout
                android:id="@+id/content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:gravity="center_vertical"
                android:orientation="@integer/banner_content_orientation"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/cta"
                app:layout_constraintStart_toEndOf="@id/icon"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Dòng trên cùng hoặc cột bên trái: Nhãn AD + Headline -->
                <LinearLayout
                    android:id="@+id/headline"
                    android:layout_width="@dimen/banner_headline_width"
                    android:layout_height="wrap_content"
                    android:layout_weight="@dimen/banner_headline_weight"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/ad_notification_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/gnt_rounded_corners_shape"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="Ad"
                        android:gravity="center"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/gnt_ad_green" />

                    <TextView
                        android:id="@+id/primary"
                        android:layout_width="@dimen/banner_primary_width"
                        android:layout_height="wrap_content"
                        android:layout_weight="@dimen/banner_primary_weight"
                        android:layout_marginStart="@dimen/banner_primary_margin_start"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#B6BCC3"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="Quảng cáo thử nghiệm" />
                </LinearLayout>

                <!-- Dòng dưới cùng hoặc cột bên phải: Body text -->
                <TextView
                    android:id="@+id/body"
                    android:layout_width="@dimen/banner_body_width"
                    android:layout_height="wrap_content"
                    android:layout_weight="@dimen/banner_body_weight"
                    android:layout_marginStart="@dimen/banner_body_margin_start"
                    android:layout_marginTop="@dimen/banner_body_margin_top"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#B6BCC3"
                    android:textSize="@dimen/banner_body_text_size"
                    tools:text="Install Flood-It App for free!" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.gms.ads.nativead.NativeAdView>
</FrameLayout>